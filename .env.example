# Public site URL used for canonical links, the sitemap, llms.txt and social previews.
# Defaults to https://scl-inc.vercel.app. Change it when a custom domain is connected.
NEXT_PUBLIC_SITE_URL=https://scl-inc.vercel.app

# Search indexing. Leave EMPTY to allow search engines on the Vercel production
# deployment only (previews and local copies stay blocked).
# Set true to force indexing on, false to force it off everywhere.
NEXT_PUBLIC_ALLOW_INDEXING=

# Ownership verification codes. Paste only the code (the content="..." value),
# not the whole <meta> tag, then redeploy.
# Google Search Console > Add property > URL prefix > HTML tag
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > Add site > HTML Meta Tag (msvalidate.01)
BING_SITE_VERIFICATION=

# Contact details. Leave blank to keep the on-site placeholders.
NEXT_PUBLIC_PHONE=(226) 927-3959
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_STREET_ADDRESS=
NEXT_PUBLIC_CITY=Ottawa
NEXT_PUBLIC_REGION=Ontario
NEXT_PUBLIC_POSTAL_CODE=
NEXT_PUBLIC_COUNTRY=Canada
NEXT_PUBLIC_HOURS=
NEXT_PUBLIC_SERVICE_AREA=Ottawa, Cornwall, and the surrounding area
NEXT_PUBLIC_FOUNDED=2023
NEXT_PUBLIC_OWNER_NAME=

# Estimate form delivery. All three are required before a submission can succeed.
# 1. Create an account at https://resend.com
# 2. Verify the domain you will send from
# 3. Create an API key
# 4. Use a from-address on that verified domain
RESEND_API_KEY=
ESTIMATE_FROM_EMAIL=
ESTIMATE_TO_EMAIL=
