# Public site URL used for links, the sitemap, and social previews.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only after placeholders are replaced and you want search engines to index the site.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contact details. Leave blank to keep the on-site placeholders.
NEXT_PUBLIC_PHONE=(226) 927-3959
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_STREET_ADDRESS=
NEXT_PUBLIC_CITY=Ottawa
NEXT_PUBLIC_REGION=Ontario
NEXT_PUBLIC_POSTAL_CODE=
NEXT_PUBLIC_COUNTRY=Canada
NEXT_PUBLIC_HOURS=
NEXT_PUBLIC_SERVICE_AREA=Ottawa, Cornwall, and the surrounding area
NEXT_PUBLIC_FOUNDED=2023
NEXT_PUBLIC_OWNER_NAME=

# Estimate form delivery. All three are required before a submission can succeed.
# 1. Create an account at https://resend.com
# 2. Verify the domain you will send from
# 3. Create an API key
# 4. Use a from-address on that verified domain
RESEND_API_KEY=
ESTIMATE_FROM_EMAIL=
ESTIMATE_TO_EMAIL=
